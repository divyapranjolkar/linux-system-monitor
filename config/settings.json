{
    "project_name": "Linux System Monitor",
    "version": "1.0.0",

    "monitoring": {
        "interval_seconds": 5,
        "disk_path": "/"
    },

    "thresholds": {
        "cpu_percent": 80,
        "memory_percent": 80,
        "disk_percent": 85
    },

    "logging": {
        "level": "INFO",
        "file": "logs/system/system_monitor.log",
        "max_bytes": 1048576,
        "backup_count": 5
    },

    "reports": {
        "directory": "reports/daily"
    }
}
